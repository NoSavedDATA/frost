class BackNode
	array<gpu_tensor> inp, out
	bool solved
	str op
	any module
	ctor(array<gpu_tensor> inp, array<gpu_tensor> out, str op)
		self.inp = inp
		self.out = out
		self.op = op
		self.solved = false
		self.module = nil

		for _inp in inp
			$backprop.grad_deps[_inp].append(self)

class backprop
	bool on
	array<BackNode> ops
	map<gpu_tensor, array<BackNode>> grad_deps
	map<str, Function<int, array<gpu_tensor>, array<gpu_tensor>, any>> backs
	ctor()
		self.on = true
		0		

	def float backward()
		for i=self.ops.size()-1, i>=0, -1
			var op = self.ops[i]

			bool shall_prop = false
			for inp in op.inp
				if inp.shall_prop
					shall_prop=true
					break
			if shall_prop
				self.backward_one(op)

		self.ops.clear()
		self.grad_deps.clear()

	def float backward_one(BackNode op)
		if op.solved
			return 0
		if !!op.out # if not loss
			for out in op.out
				if !out
					continue
				if !self.grad_deps.has(out) or !out.shall_prop
					continue
				for dep in self.grad_deps[out]
					self.backward_one(dep)

		self.backs[op.op](op.inp, op.out, op.module)
		op.solved=true


	def float register(array<gpu_tensor> inp, array<gpu_tensor> out, str op)
		if self.on
			self.ops.append(new BackNode(inp, out, op))

	def float register_module(array<gpu_tensor> inp, array<gpu_tensor> out, any module, str op)
		if !self.on
			return 0
		var node = new BackNode(inp, out, op)
		node.module = module
		self.ops.append(node)
