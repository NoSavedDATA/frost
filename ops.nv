def int add_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var x = inp[0]
	float_pp dx = x.getd(), dy = inp[1].getd()
	var dout = out[0].getd()
	acc_tensors(dx, dout, x.dims_prod)
	acc_tensors(dy, dout, x.dims_prod)

def int mma_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var x = inp[0], y = inp[1]
	int m=x.dims[0], n=x.dims[1], p=y.dims[0]
	matmul_backward(x.ptr, inp[1].ptr,
					x.getd(), y.getd(),
					out[0].getd(), m, n, p)


def int view_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var x = inp[0]
	float_pp dx = x.getd()
	var dout = out[0].getd()
	acc_tensors(dx, dout, x.dims_prod)





def int mse_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var y_hat = inp[0]
	mse_backward_kernel(y_hat.getd(),
						y_hat.ptr, inp[1].ptr,
						y_hat.dims_prod)

def int ce_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var y_hat = inp[0]
	ce_backward_kernel(y_hat.getd(),
					   y_hat.ptr, inp[1].ptr,
					   y_hat.dims[0], y_hat.dims[1])

def gpu_tensor softmax(gpu_tensor a)
	gpu_tensor ret = new gpu_tensor(a.dims, "none")
	float_pp probs = softmax_k(a.ptr, a.dims[0], a.dims[-1])
	ret.ptr = probs
	return ret
















def gpu_tensor +(gpu_tensor a, gpu_tensor b)
	gpu_tensor ret = new gpu_tensor(a.dims, "none")
	ret.ptr = add_tensors(a.ptr, b.ptr, a.dims_prod)

	bool shall_prop = a.shall_prop or b.shall_prop
	ret.shall_prop = shall_prop
	if shall_prop
		$backprop.register([a, b], [ret], "add")
	return ret


def gpu_tensor @(gpu_tensor a, gpu_tensor b)
	int m = a.dims[0], n = a.dims[1], p = b.dims[0]

	array<int> new_dims = [m, p]
	gpu_tensor ret = new gpu_tensor(new_dims, "none")
	ret.ptr = mma_tensors(a.ptr, b.ptr, m, n, p)

	bool shall_prop = a.shall_prop or b.shall_prop
	ret.shall_prop = shall_prop
	if shall_prop
		$backprop.register([a, b], [ret], "mma")
	return ret






kernel void tensor_eq_k(float[] z, float[] x, float[] y, int n)
	int idx = bx*256 + tx
	if idx<n
		z[idx] = x[idx] == y[idx]


def gpu_tensor ==(gpu_tensor a, gpu_tensor b)
	gpu_tensor ret = new gpu_tensor(a.dims, "zeros")
	int n = a.dims reduce *
	launch [n/|256] [256] tensor_eq_k(ret.ptr offby 0,
							a.ptr offby 0, b.ptr offby 0,
							n)
	return ret


kernel void tensor_div_kernel(float[] z, float[] x, int y, int n)
	int idx = bx*256 + tx
	if idx<n
		z[idx] = x[idx] / y


def gpu_tensor /(gpu_tensor a, int b)
	gpu_tensor ret = new gpu_tensor(a.dims, "zeros")
	int n = a.dims reduce *
	launch [n/|256] [256] tensor_div_kernel(ret.ptr offby 0,
							a.ptr offby 0, b,
							n)
	return ret




def gpu_tensor mse_loss(gpu_tensor a, gpu_tensor b)
	gpu_tensor ret = new gpu_tensor(a.dims, "none")
	ret.ptr = add_tensors(a.ptr, b.ptr, a.dims_prod)
	bool shall_prop = a.shall_prop or b.shall_prop
	ret.shall_prop = shall_prop
	if shall_prop
		$backprop.register([a, b], [ret], "mse")
	return ret



def gpu_tensor ce_loss(gpu_tensor a, gpu_tensor b)
	gpu_tensor ret = new gpu_tensor(a.dims, "none")
	ret.ptr = add_tensors(a.ptr, b.ptr, a.dims_prod)
	bool shall_prop = a.shall_prop or b.shall_prop
	ret.shall_prop = shall_prop
	if shall_prop
		$backprop.register([a, b], [ret], "ce")
	return ret
