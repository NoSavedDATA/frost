kernel void relu_kernel(float[] y, float[] x, int n)
	int idx = bx*1024 + tx
	if idx>=n
		return
	if x[idx]>0
		y[idx] = x[idx]
	else
		y[idx] = 0

kernel void relu_backward_kernel(float[] y, float[] dx, float[] dy, int n)
	int idx = bx*1024 + tx
	if idx>=n
		return
	if y[idx]>0
		dx[idx] += dy[idx]


def gpu_tensor relu(gpu_tensor x)
	gpu_tensor ret = new gpu_tensor(x.dims, "zeros_pool")
	launch [x.dims_prod/|1024] [1024] relu_kernel(
							ret.ptr offby 0, x.ptr offby 0, x.dims_prod)

	ret.shall_prop = x.shall_prop
	if x.shall_prop
		$backprop.register([x], [ret], "relu")
	return ret

def int relu_backward(array<gpu_tensor> inp, array<gpu_tensor> out, any module)
	var x = inp[0]
	launch [x.dims_prod/|1024] [1024] relu_backward_kernel(
							out[0].ptr offby 0, x.getd() offby 0,
							out[0].getd() offby 0, x.dims_prod)
